{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "pwa-node",
      "request": "launch",
      "name": "Debug Node Backend",
      "program": "${workspaceFolder:selection-analyzer-be}/src/index.js",
      "cwd": "${workspaceFolder:selection-analyzer-be}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "runtimeArgs": ["--enable-source-maps"]
    },
    {
      "type": "pwa-chrome",
      "request": "launch",
      "name": "Debug Vue App",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder:selection-analyzer-fe}/src",
      "runtimeExecutable": "C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe",
      "userDataDir": true
    }
  ],
  "compounds": [
    {
      "name": "Debug Full Stack",
      "configurations": [
        "Debug Node Backend",
        "Debug Vue App"
      ]
    }
  ]
}
